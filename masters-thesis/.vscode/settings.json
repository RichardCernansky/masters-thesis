{
  // main.pdf is written next to main.tex, while every auxiliary file
  // (.aux, .log, .toc, .bbl, .fls, ...) is kept out of sight in build/.
  "latex-workshop.latex.outDir": "%DIR%",

  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-auxdir=%DIR%/build",
        "-outdir=%DIR%",
        "%DOC%"
      ],
      "env": {}
    }
  ],

  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": ["latexmk"]
    }
  ],

  // Inverse search (PDF -> source): double-click any typeset text in the PDF tab.
  "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",

  // The build rewrites main.pdf several times over a few seconds. Wait for it to
  // settle, then reload the viewer ONCE -- two overlapping reloads make the viewer
  // snapshot a mid-load position and restore you to page 1.
  "latex-workshop.latex.watch.pdf.delay": 5000
}
