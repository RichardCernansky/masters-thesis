\newlabel{tab:overall}{{2.1}{25}{Overall detection results on the nuScenes validation split. Higher is better for mAP and NDS; lower is better for the five true-positive errors. Numbers are absolute (mAP and NDS as fractions; errors in their native units)}{table.2.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2.2}{\ignorespaces Per-class mean AP on the nuScenes validation split. ConvLSTM improves over the baseline on \emph  {motorcycle}, \emph  {bicycle}, \emph  {construction vehicle}, and \emph  {trailer} while regressing on all remaining classes. The ReasonNet MB row shows the class-imbalanced nature of the collapse: only \emph  {car} retains any detection capability, while all other classes drop to exactly zero.}}{25}{table.2.2}\protected@file@percent }
\newlabel{tab:perclass}{{2.2}{25}{Per-class mean AP on the nuScenes validation split. ConvLSTM improves over the baseline on \emph {motorcycle}, \emph {bicycle}, \emph {construction vehicle}, and \emph {trailer} while regressing on all remaining classes. The ReasonNet MB row shows the class-imbalanced nature of the collapse: only \emph {car} retains any detection capability, while all other classes drop to exactly zero}{table.2.2}{}}
