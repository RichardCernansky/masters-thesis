\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces Ground-truth (top) and predicted (bottom) class-specific heatmap $\hat  {S}$ over the LiDAR BEV plane, stage 1 (LiDAR only), training step 600. Each panel shows the aggregate max channel plus one channel per class; probability mass is already concentrated on \emph  {car} and \emph  {pedestrian}, consistent with the per-class EPA/AMOTA breakdown in Tables~\ref {tab:livip3d_results} and~\ref {tab:livip3d_tpfp}.}}{27}{figure.2.3}\protected@file@percent }
\newlabel{fig:livip3d-heatmap}{{2.3}{27}{Ground-truth (top) and predicted (bottom) class-specific heatmap $\hat {S}$ over the LiDAR BEV plane, stage 1 (LiDAR only), training step 600. Each panel shows the aggregate max channel plus one channel per class; probability mass is already concentrated on \emph {car} and \emph {pedestrian}, consistent with the per-class EPA/AMOTA breakdown in Tables~\ref {tab:livip3d_results} and~\ref {tab:livip3d_tpfp}}{figure.2.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.4}{\ignorespaces Raw SMCA Gaussian mask for three of the six cameras, training step 600, overlaid on the input image. The mask is anisotropic and camera-dependent ($\sigma _{\text  {raw}}$ shown per camera), sized from the projected 3D box extent as in TransFusion Sec.~3.4.}}{28}{figure.2.4}\protected@file@percent }
\newlabel{fig:livip3d-smca-mask}{{2.4}{28}{Raw SMCA Gaussian mask for three of the six cameras, training step 600, overlaid on the input image. The mask is anisotropic and camera-dependent ($\sigma _{\text {raw}}$ shown per camera), sized from the projected 3D box extent as in TransFusion Sec.~3.4}{figure.2.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.5}{\ignorespaces SMCA cross-attention for the top-20 heatmap queries, same cameras and step as Fig.~\ref {fig:livip3d-smca-mask}. Top: attention after the Gaussian mask is applied, concentrated tightly on nearby vehicles. Bottom: the same attention with the mask removed (``pure attention''), visibly noisier and less object-centred -- illustrating why the Gaussian prior helps the network attend to the correct region early in training.}}{28}{figure.2.5}\protected@file@percent }
\newlabel{fig:livip3d-smca-attn}{{2.5}{28}{SMCA cross-attention for the top-20 heatmap queries, same cameras and step as Fig.~\ref {fig:livip3d-smca-mask}. Top: attention after the Gaussian mask is applied, concentrated tightly on nearby vehicles. Bottom: the same attention with the mask removed (``pure attention''), visibly noisier and less object-centred -- illustrating why the Gaussian prior helps the network attend to the correct region early in training}{figure.2.5}{}}
