\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces Early collapse diagnostic for \emph  {TemporalPointPillar-MB} (short-term bank only). Top: BEV energy, post-fusion energy, and per-cell difference $|\tilde  {F}_t - F_t|$. Middle: heatmap \texttt  {mp\_ch0}, short-term usage \texttt  {st\_usage\_mean}, and \texttt  {st\_mp0\_mean}. Bottom: attention maps from three query positions (cyan crosses). Usage is near-uniform and attention concentrates on peripheral cells---the signature of a collapsed memory.}}{22}{figure.2.1}\protected@file@percent }
\newlabel{fig:mb-diagnostic}{{2.1}{22}{Early collapse diagnostic for \emph {TemporalPointPillar-MB} (short-term bank only). Top: BEV energy, post-fusion energy, and per-cell difference $|\tilde {F}_t - F_t|$. Middle: heatmap \texttt {mp\_ch0}, short-term usage \texttt {st\_usage\_mean}, and \texttt {st\_mp0\_mean}. Bottom: attention maps from three query positions (cyan crosses). Usage is near-uniform and attention concentrates on peripheral cells---the signature of a collapsed memory}{figure.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Advanced collapse state on a different sample (short-term bank only). Top: \texttt  {mp\_ch0}, \texttt  {st\_usage\_mean}, and \texttt  {st\_mp0\_mean}. Bottom: attention maps from three query positions ($\mathtt  {mp0}$ values above). Attention saturates at the same corner cells for every query, confirming the bank has become a position-agnostic retriever---consistent with the class collapse in Table~\ref {tab:perclass}.}}{23}{figure.2.2}\protected@file@percent }
\newlabel{fig:mb-collapse}{{2.2}{23}{Advanced collapse state on a different sample (short-term bank only). Top: \texttt {mp\_ch0}, \texttt {st\_usage\_mean}, and \texttt {st\_mp0\_mean}. Bottom: attention maps from three query positions ($\mathtt {mp0}$ values above). Attention saturates at the same corner cells for every query, confirming the bank has become a position-agnostic retriever---consistent with the class collapse in Table~\ref {tab:perclass}}{figure.2.2}{}}
